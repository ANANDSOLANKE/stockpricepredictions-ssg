<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{{ page_title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#0f1b2b; --card:#0f1f34; --border:#10243e; --soft:#0b1220; --text:#dbe6ff;
      --muted:#94a3b8; --chip-border:#1b2b45; --win:#e6f5ef; --loss:#fdecec;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif}
    a{color:#1a73e8;text-decoration:none}
    .wrap{max-width:1020px;margin:28px auto;padding:0 16px}
    .header{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 20px;margin-bottom:16px}
    .title{font-size:28px;font-weight:800;letter-spacing:.2px;margin:0 0 6px}
    .sub{color:var(--muted);font-size:14px}

    /* NEW: price strip under title */
    .stat-strip{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:14px;color:#c9daff;margin-top:10px}
    .stat-strip .dot{opacity:.4}

    .grid{display:grid;gap:16px}
    .hero{border-radius:16px;padding:22px;margin-bottom:6px;border:1px solid var(--border);}
    .hero .row{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
    .chip{display:inline-flex;align-items:center;gap:6px;background:#123255;border:1px solid var(--chip-border);color:#bcd7ff;border-radius:999px;padding:6px 12px;font-weight:600;font-size:13px}
    .signal{font-size:56px;font-weight:900;letter-spacing:1px;margin:8px 0 4px;display:flex;align-items:center}
    .signal--bull{color:#87f2c2}
    .signal--bear{color:#ffb4b4}
    .muted{color:var(--muted);font-size:12px}

    /* Animated Arrows */
    @keyframes upFloat{0%{transform:translateY(4px)}50%{transform:translateY(-2px)}100%{transform:translateY(4px)}}
    @keyframes downFloat{0%{transform:translateY(-4px)}50%{transform:translateY(2px)}100%{transform:translateY(-4px)}}
    .arrow{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;margin-right:10px;border-radius:8px;font-weight:900;font-size:22px;background:rgba(255,255,255,.08)}
    .arrow-up{color:#86f3c1;animation:upFloat 1.8s ease-in-out infinite}
    .arrow-down{color:#ffb4b4;animation:downFloat 1.8s ease-in-out infinite}
    @media (prefers-reduced-motion:reduce){.arrow-up,.arrow-down{animation:none}}

    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}
    .card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px}
    .card h4{margin:0 0 10px;font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:#9fb3d9}
    .stat{font-size:28px;font-weight:800}

    .table-card{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-top:16px}
    table{width:100%;border-collapse:separate;border-spacing:0}
    thead th{color:#9fb3d9;text-align:left;font-size:12px;letter-spacing:.06em;padding:12px 14px;border-bottom:1px solid var(--border)}
    tbody td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:14px}
    .result-win{background:var(--win);color:#176a45;font-weight:700;display:inline-block;padding:4px 10px;border-radius:999px}
    .result-loss{background:var(--loss);color:#9d2431;font-weight:700;display:inline-block;padding:4px 10px;border-radius:999px}
    .section-title{margin:22px 0 8px;font-weight:800;font-size:18px}
    .footer-note{margin-top:14px;color:#a6b7d5;font-size:12px}

    @media (max-width:860px){
      .cards{grid-template-columns:1fr}
      .hero .row{flex-direction:column;align-items:flex-start}
    }
  </style>
</head>
<body>
  <div class="wrap">

    <div class="header">
      <h1 class="title">{{ company_name }} <small style="font-size:14px;color:var(--muted);font-weight:600;">({{ symbol }})</small></h1>
      <div class="sub">Region: {{ region }} · Country: {{ country }} · Exchange: {{ exchange }}</div>
      <div class="sub">Last build: {{ last_build }}</div>

      <!-- NEW OHLC strip -->
      <div class="stat-strip">
        <span><strong>Date:</strong> {{ ohlc_date }}</span>
        <span class="dot">•</span>
        <span><strong>Open:</strong> {{ ohlc_open }}</span>
        <span class="dot">•</span>
        <span><strong>High:</strong> {{ ohlc_high }}</span>
        <span class="dot">•</span>
        <span><strong>Low:</strong> {{ ohlc_low }}</span>
        <span class="dot">•</span>
        <span><strong>Close:</strong> {{ ohlc_close }}</span>
        <span class="dot">•</span>
        <span><strong>% Change:</strong> {{ change_pct }}%</span>
      </div>
    </div>

    <div class="grid">
      <!-- HERO -->
      <div class="hero" style="
        background:{{ '#0c2f1f' if signal_upper == 'Bullish' else '#3a0c0c' }};
        border:1px solid {{ '#174a34' if signal_upper == 'Bullish' else '#5a1c1c' }};
      ">
        <div class="row">
          <div>
            <div class="chip">
              Stock prediction for <span style="font-weight:800">{{ pred_date }}</span>
            </div>
            <div class="signal {{ signal_class }}">
              <span class="arrow {{ 'arrow-up' if signal_upper == 'Bullish' else 'arrow-down' }}">
                {{ '▲' if signal_upper == 'Bullish' else '▼' }}
              </span>
              {{ signal_upper }}
            </div>
            <div class="muted">{{ company_name }}</div>
          </div>
        </div>
      </div>

      <div class="cards">
        <div class="card">
          <h4>Model Performance</h4>
          <div class="stat">{{ accuracy_pct }}</div>
          <div class="muted">{{ accuracy_note }}</div>
        </div>

        <div class="card">
          <h4>Our Methodology</h4>
          <div class="muted">{{ methodology }}</div>
        </div>

        <div class="card">
          <h4>Important Disclosures</h4>
          <div class="muted">{{ disclaimer }}</div>
        </div>
      </div>

      <div class="table-card">
        <h3 class="section-title" style="padding:14px 16px 0;margin:0">Model vs. Actual: Last 7 Days Performance</h3>
        <table>
          <thead>
            <tr>
              <th>Date</th><th>AI Prediction</th><th>Actual</th><th>Result</th>
            </tr>
          </thead>
          <tbody>
            {{ last7_rows | safe }}
          </tbody>
        </table>
      </div>

      <div class="card">
        <h4>In-Depth Technical Analysis of {{ company_name }}</h4>
        <div class="muted">{{ long_text }}</div>
      </div>

      <div class="footer-note">
        E-E-A-T: Author <b>StockPricePredictions Research</b> · Org: SPP Labs · Contact:
        <a href="mailto:hello@stockpricepredictions.com">hello@stockpricepredictions.com</a>
      </div>
    </div>

  </div>
</body>
</html>
